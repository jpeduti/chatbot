    "businessLogic": {
      "newUserFlow": {
        "step1": "Auto-detección de número telefónico desde WhatsApp ID",
        "step2": "Mensaje de confirmación con valor claro (estándar mundial)",
        "step3": "Opciones: 1) Confirmar número, 2) Dar otro número, 3) Continuar sin número",
        "step4": "Guardado inmediato en BD al confirmar teléfono",
        "step5": "Captura progresiva: nombre → email → edad → región",
        "benefits": "50% menos fricción, 0% pérdida de datos, experiencia personalizada"
      },
      "chatbotFlows": [
        "1️⃣ Explorar carreras (por facultad)",
        "2️⃣ Proceso de admisión 2025",
        "3️⃣ Costos y becas", 
        "4️⃣ Modalidades de estudio",
        "5️⃣ Hablar con un asesor",
        "6️⃣ Búsqueda directa de carrera (NUEVO)"
      ],
      "facultades": [
        "A) Artes: Teatro, Danza, Música, Artes Visuales",
        "B) Comunicaciones: Audiovisual, Periodismo, Publicidad", 
        "C) Arquitectura y Diseño: Arquitectura, Diseño de Interiores",
        "D) Ciencias Jurídicas: Derecho, Psicología",
        "E) Negocios y Tecnología: Ing. Comercial, Contador Auditor"
      ],
      "prospectoCaptureFlow": [
        "1. NUEVO: Auto-detección de teléfono → CONFIRMACIÓN → GUARDADO INMEDIATO",
        "2. Solicita nombre → ACTUALIZA PROSPECTO CON TELÉFONO",
        "3. Solicita email (con validación) → ACTUALIZA PROSPECTO",
        "4. Solicita edad → ACTUALIZA PROSPECTO", 
        "5. Solicita región → FINALIZA PROSPECTO COMPLETO",
        "6. NUEVO: Sistema de timeout con warnings a 1.5min y timeout a 2min",
        "7. NUEVO: Guardado automático en timeout para evitar pérdida",
        "8. Clasificación automática según punto de abandono",
        "9. Zero data loss - todos los campos guardados inmediatamente",
        "10. NUEVO: Reconocimiento de usuarios recurrentes por teléfono"
      ],
      "progressiveCaptureStates": {
        "captura_en_proceso": "Usuario completando datos activamente",
        "abandono_solo_nombre": "Abandonó después de dar solo nombre",
        "abandono_con_email": "Abandonó después de nombre + email",
        "abandono_con_edad": "Abandonó después de nombre + email + edad",
        "abandono_con_region": "Abandonó después de nombre + email + edad + región",
        "abandono_incompleto": "Timeout durante proceso de captura",
        "captura_completa": "Completó todos los campos incluyendo teléfono"
      }
    },
    "conventions": {
      "codeStyle": {
        "backend": "TypeScript con tipado fuerte",
        "frontend": "Vue 3 Composition API + TypeScript",
        "naming": "camelCase para variables, PascalCase para componentes",
        "database": "snake_case para tablas y campos"
      },
      "fileStructure": {
        "chatbot": "src/{actions,data,utils}/",
        "dashboard": "src/{components,composables,views,types}/",
        "components": "Organizados por funcionalidad (chat/, prospectos/, layout/)"
