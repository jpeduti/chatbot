{
  "name": "Progressive Capture - Flujo Completo",
  "description": "Test del sistema de captura progresiva completo sin abandonos",
  "version": "1.0",
  "author": "UNIACC Testing System",
  "tags": ["progressive-capture", "complete-flow", "zero-data-loss"],
  
  "scenario": {
    "user_id": "test_user_progressive_complete_001",
