          "table": "prospectos",
          "should_exist": true,
          "conditions": {
            "whatsapp": "56912345001",
            "nombre": "Juan Pérez Testing",
            "tipo_consulta": "captura en proceso",
            "email": null
          }
        },
        "validation": {
          "prospecto_created": true,
